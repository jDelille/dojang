    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "next-auth": "^4.24.11",
    "next-intl": "^4.13.4",
