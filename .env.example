# ─────────────────────────────────────────────────────────────────────────────
# Roster — environment configuration
# Copy to .env and fill in. The install wizard (/install) can write most of
# these for you on first boot; anything left blank here is configurable
# per-workspace from Settings → Integrations.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://roster:roster@localhost:5432/roster?schema=public"
REDIS_URL="redis://localhost:6379"

NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# 32-byte key (base64) used to encrypt third-party credentials at rest.
# openssl rand -base64 32
# WARNING: changing this makes every stored integration credential unreadable.
ENCRYPTION_KEY=""

# Public origin used for webhooks, pay links and the chat widget snippet.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Put a workspace's chat agent on your own landing page: set this to that
# workspace's slug. Leave blank and no widget is rendered. Compiled into the
# build, so `npm run build` again after changing it.
NEXT_PUBLIC_WIDGET_WORKSPACE=""
# Messages the website widget will answer per workspace per day. Every one
# spends your own AI credit, so lower it on a public demo. Default 2000.
WIDGET_DAILY_LIMIT=""

# ── Multi-tenant / white-label ───────────────────────────────────────────────
# "single"  — one workspace, no agency layer (Phase 1 default)
# "multi"   — agencies + sub-accounts + Super Admin panel (Phase 4)
ROSTER_TENANCY_MODE="single"

# ── AI providers (platform defaults; workspaces may override) ────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── Twilio (voice + SMS + WhatsApp) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Google Maps Places (lead generation) ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=""

# ── Calendar OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""

# ── Email (SMTP — Postmark / SES / Mailgun / anything) ───────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Roster <no-reply@example.com>"

# Optional fallback: any provider that accepts a JSON POST with a bearer token
# (Resend, Mailgun, SendGrid, Postmark, Brevo, or your own relay). Used only
# when a workspace has not set its own SMTP. Leave blank to use SMTP alone.
MAIL_API_ENDPOINT=""
MAIL_API_KEY=""
EMAIL_FROM="Roster <no-reply@example.com>"

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Firebase Cloud Messaging for native mobile push is configured in the app:
# Settings → Integrations → Firebase Cloud Messaging → Connect. Paste the whole
# service-account JSON there; it is stored encrypted, not in this file.

# ── Odoo (academy system of record) ──────────────────────────────────────────
# Odoo 20 with the dojo_* addons. Roster reads classes, arrivals and members
# through Odoo's JSON-2 API with an API key (Odoo: Preferences → Account
# Security → New API Key). Leave blank to hide the academy panels.
ODOO_URL=""
ODOO_DB=""
ODOO_API_KEY=""

# ── Licensing ────────────────────────────────────────────────────────────────
# The license server that checks purchase codes. Pre-filled in copies sold by
# the author; leave blank to check against Envato directly with your own token.
LICENSE_API_URL=""
LICENSE_PRODUCT="roster"
# Verifies both direct-sale keys and the license server's replies. Safe to
# publish — it can check a signature but cannot create one.
LICENSE_PUBLIC_KEY=""
# Only for running your own checks against Envato without a license server.
ENVATO_PERSONAL_TOKEN=""
# Set by the installer once the purchase code is verified.
ROSTER_LICENSE_DOMAIN=""

# Odoo companion workflow (/kiosk/v2/staff/companion-workflow). Server only.
DOJANG_KIOSK_TOKEN=""
DOJANG_STAFF_GATEWAY_KEY=""
# Odoo companion hub site (dojo.hub.site id); staff connect their own Odoo login in Settings
DOJANG_HUB_SITE_ID=""
