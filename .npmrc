# next-auth 4.24 declares nodemailer@^7 as a *peerOptional* dependency, used
# only by its Email provider. Roster authenticates with credentials and never
# loads that provider, so the conflict is inert — but npm 10 (the version that
# ships with Node 22 LTS) still refuses the install, while npm 11 resolves it.
#
# Without this, `npm install` fails out of the box for anyone on npm 10.
legacy-peer-deps=true
